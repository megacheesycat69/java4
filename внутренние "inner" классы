// Внешний класс не видит переменные внутреннего класса как свои собственные:

public class Outer 
{
    void test() 
    {
        // x = 10; // ошибка: переменная x не существует в Outer
        Inner in = new Inner();
        in.x = 10; // а так уже можно, доступ через объект
    }

    class Inner 
    {
        private int x;
    }
}
