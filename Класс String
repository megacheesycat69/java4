import java.util.StringJoiner;
public class StringJoinerDemo {
    public static void main(String[] args) {
        
        //1: Только разделител
        StringJoiner fruits = new StringJoiner(", ");
        fruits.add("Яблоко").add("Банан").add("Апельсин");
        
        System.out.println("Фрукты: " + fruits.toString()); 
        //вывод: Фрукты: Яблоко, Банан, Апельсин


        //2:разделитель, префикс "[" и суффикс "]"
        //это очень удобно для форматирования списков или массивов
        StringJoiner numbers = new StringJoiner("; ", "[", "]");
        numbers.add("Один").add("Два").add("Три");
        
        System.out.println("Числа: " + numbers.toString()); 
        //вывод: Числа
    }
}

3)Тройные двойные кавычки (""") используются в Java для создания текстовых блоков. Они нужны для удобного написания многострочного текста.
