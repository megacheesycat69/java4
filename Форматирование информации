)import java.util.Date;
public class DateFormatterExample {
    public static void main(String[] args) {
        Date currentDate = new Date();

        // 1.Форматируем дату (День недели, месяц, год)
        System.out.printf("Сегодня: %1$tA, Месяц: %1$tB, Год: %1$tY%n", currentDate);

        // 2. Форматируем время
        System.out.printf("Точное время: %1$tH:%1$tM%n", currentDate);
    }
}
