//перегрузка
class Calc {
    int sum(int a, int b) { return a + b; }
    double sum(double a, double b) { return a + b; }
}

//переопределение 
class Animal {
    void sound() { System.out.println("Some sound"); }
}
class Dog extends Animal {
    @Override
    void sound() { System.out.println("Bark"); }
}
